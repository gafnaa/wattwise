# =============================================================================
# WattWise — Environment Variables Template
# Salin file ini menjadi `.env` lalu isi kredensial yang sesuai.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL — Managed Supabase / Neon atau Docker lokal)
# -----------------------------------------------------------------------------
# Pilihan A — Supabase (Transaction Pooler untuk runtime + Direct untuk migrasi):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
# Pilihan B — Neon:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/wattwise?sslmode=require"
# DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST].[REGION].aws.neon.tech/wattwise?sslmode=require"
#
# Pilihan C — Docker PostgreSQL Lokal (`docker compose up -d db`):
DATABASE_URL="postgresql://wattwise:wattwise_dev@localhost:5432/wattwise?schema=public"
DIRECT_URL="postgresql://wattwise:wattwise_dev@localhost:5432/wattwise?schema=public"

# -----------------------------------------------------------------------------
# Autentikasi Web Dashboard
# -----------------------------------------------------------------------------
JWT_SECRET="ganti-dengan-random-secret-minimal-32-karakter"

# -----------------------------------------------------------------------------
# Telegram Bot (WattWise Bot)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_DEFAULT_CHAT_ID=""

# -----------------------------------------------------------------------------
# Generative AI Advisor (Opsional — Rekomendasi Cerdas & Chat Bebas Telegram)
# Jika kosong, sistem otomatis fallback ke Rule-Based Playbook.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Alternatif OpenRouter / OpenAI:
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="google/gemini-2.5-flash"

# -----------------------------------------------------------------------------
# Aplikasi, Maintenance Cron & Mode Demo
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WATTWISE_DEMO_MODE="true"
WATTWISE_ENFORCE_AUTH="false"
CRON_SECRET="ganti-dengan-secret-cron-retention"
